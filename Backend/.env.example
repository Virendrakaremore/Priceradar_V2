# ---- Core ----
DATABASE_URL=sqlite:///priceradar.db          # production: postgresql://user:pass@host:5432/priceradar
CORS_ORIGINS=http://localhost:3000            # comma-separated frontend origins
PUBLIC_APP_URL=http://localhost:3000          # used for links in emails
API_TOKEN=                                    # optional shared bearer token protecting the API
DEFAULT_USER_EMAIL=                           # optional; can also be set in the Settings page

# ---- SMTP (Gmail: smtp.gmail.com / 587 / TLS and an App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false                            # set true (and SMTP_USE_TLS=false) for port 465
EMAIL_FROM=
# Legacy EMAIL_USER / EMAIL_PASS are still read if SMTP_USERNAME / SMTP_PASSWORD are empty.

# ---- Monitoring ----
MONITOR_INTERVAL_SECONDS=15                   # requested interval
RETAILER_MIN_INTERVAL_SECONDS=60              # enforced floor per retailer; lower only where you are permitted
WORKER_CONCURRENCY=2
PER_RETAILER_CONCURRENCY=1
FETCH_TIMEOUT_SECONDS=30
RESPECT_ROBOTS=true
USE_PLAYWRIGHT=true
